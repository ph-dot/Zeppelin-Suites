# ==========================================
# Zeppelin Suites - Environment Configuration Template
# Copy this file to .env and fill in your local settings
# ==========================================

# Application Settings
APP_NAME="Zeppelin Suites"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Zeppelin-Suites/public

# Database Configuration (MySQL / PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zepellin_test
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Email / SMTP Configuration (PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
MAIL_FROM_EMAIL=your_email@gmail.com
MAIL_FROM_NAME="Zeppelin Suites"

# Owner Portal Configuration
OWNER_PORTAL_LOGIN_URL=http://localhost/Zeppelin-Suites/public/login
